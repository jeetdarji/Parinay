# ─────────────────────────────────────────────────────────────────────────
# TDC Matchmaker Backend — environment variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────────────────────

# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# SERVICE ROLE key — NOT the anon key.
# The backend uses the service role key because it must bypass RLS when
# fetching the full opposite-gender dummy pool for matching and notes for
# AI journey summaries (Phase 3). This key is server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gemini API key (used in Phase 3 for match explanations / journey summaries).
GEMINI_API_KEY=your-gemini-api-key-here

# Allowed CORS origin for the frontend.
# In production this is the Vercel URL (e.g. https://tdc-dashboard.vercel.app).
# In development it is http://localhost:5173 (Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────
# NEVER commit the real .env file. Ensure .env is listed in .gitignore.
# The service role key grants full database access — treat it as a secret.
# ─────────────────────────────────────────────────────────────────────────
